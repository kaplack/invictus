generator client {
  provider = "prisma-client-js"
  output = "./client"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum UserStatus {
  ACTIVE
  SUSPENDED
}
model User {
  registrationAudits RegistrationAudit[]
  createdEvents Event[] @relation("EventCreator")
  teamMemberships TeamMember[]
  teamAdmissions TeamAdmission[]
  shopCartUserRows ShopCart[] @relation("ShopCartUser")
  eventOrganizerRows Event[] @relation("EventOrganizer")
  profileUserRows ParticipantProfile[] @relation("ProfileUser")
  registrationUserRows EventRegistration[] @relation("RegistrationUser")
  id String @id @default(uuid()) @db.Uuid
  username String @unique @db.VarChar(30)
  name String @default("") @db.VarChar(80)
  lastName String @default("") @map("last_name") @db.VarChar(120)
  email String @unique @db.VarChar(254)
  passwordHash String @map("password_hash") @db.VarChar(255)
  role String @default("USER") @db.VarChar(40)
  status UserStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  sessions Session[]
  files StoredFile[]
  orders CommerceOrder[]
  reviewedPayments ManualPayment[]
  paymentOperations PaymentOperation[]
  recipientMemberships RecipientMember[]
  @@map("users")
}
model StoredFile {
  routeImageRows EventRouteImage[]
  routeEvents Event[] @relation("EventRoute")
  teamPaymentQrs TeamPaymentMethod[]
  teamLogos Team[] @relation("TeamLogo")
  teamBanners Team[] @relation("TeamBanner")
  shopImageRows ShopProduct[] @relation("ShopImage")
  eventPrimaryRows Event[] @relation("EventPrimary")
  eventBannerRows Event[] @relation("EventBanner")
  benefitImageRows EventBenefit[] @relation("BenefitImage")
  profileAvatarRows ParticipantProfile[] @relation("ProfileAvatar")
  profileBannerRows ParticipantProfile[] @relation("ProfileBanner")
  registrationProofRows EventRegistration[] @relation("RegistrationProof")
  guestAccessHash String? @map("guest_access_hash") @db.Char(64)
  id String @id @db.Uuid
  ownerId String? @map("owner_id") @db.Uuid
  key String @unique @db.VarChar(100)
  name String @db.VarChar(180)
  contentType String @map("content_type") @db.VarChar(100)
  size Int
  visibility String @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")
  owner User? @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  paymentProof ManualPayment?
  recipientQrs PaymentRecipient[] @relation("RecipientQr")
  operationQrs PaymentOperation[] @relation("OperationQr")
  @@index([ownerId, createdAt])
  @@map("stored_files")
}

model CommerceOrder {
  checkoutOrderRows CommerceCheckout[] @relation("CheckoutOrder")
  id String @id @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  status String @db.VarChar(20)
  items Json
  totalCents Int @map("total_cents")
  currency String @db.Char(3)
  createdAt DateTime @default(now()) @map("created_at")
  @@index([ownerId, createdAt])
  @@map("commerce_orders")
}

model ManualPayment {

  id String @id @db.Uuid
  operationId String @map("operation_id") @db.Uuid
  operation PaymentOperation @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  method String @db.VarChar(10)
  status String @db.VarChar(20)
  amountCents Int @map("amount_cents")
  currency String @db.Char(3)
  proofFileId String? @unique @map("proof_file_id") @db.Uuid
  proof StoredFile? @relation(fields: [proofFileId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime @default(now()) @map("created_at")
  reviewedAt DateTime? @map("reviewed_at")
  reviewedBy String? @map("reviewed_by") @db.Uuid
  reviewer User? @relation(fields: [reviewedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  rejectionReason String? @map("rejection_reason") @db.VarChar(300)
  result PaymentResult?
  @@index([operationId, createdAt])
  @@map("manual_payments")
}

model PaymentRecipient {
  team Team?
  registrationConfigRecipientRows EventRegistrationConfig[] @relation("RegistrationConfigRecipient")
  id String @id @db.Uuid
  name String @db.VarChar(120)
  phone String? @db.VarChar(9)
  holder String? @db.VarChar(120)
  qrFileId String? @map("qr_file_id") @db.Uuid
  qr StoredFile? @relation("RecipientQr", fields: [qrFileId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  members RecipientMember[]
  operations PaymentOperation[]
  @@map("payment_recipients")
}
model RecipientMember {

  recipientId String @map("recipient_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  manage Boolean @default(false)
  review Boolean @default(false)
  recipient PaymentRecipient @relation(fields: [recipientId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@id([recipientId, userId])
  @@map("recipient_members")
}
model PaymentOperation {

  id String @id @db.Uuid
  sourceType String @map("source_type") @db.VarChar(40)
  sourceId String @map("source_id") @db.VarChar(100)
  payerId String? @map("payer_id") @db.Uuid
  payer User? @relation(fields: [payerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  recipientId String @map("recipient_id") @db.Uuid
  recipient PaymentRecipient @relation(fields: [recipientId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  amountCents Int @map("amount_cents")
  currency String @db.Char(3)
  instructions Json
  qrFileId String? @map("qr_file_id") @db.Uuid
  qr StoredFile? @relation("OperationQr", fields: [qrFileId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  acceptingPayments Boolean @default(true) @map("accepting_payments")
  acceptingReviews Boolean @default(true) @map("accepting_reviews")
  createdAt DateTime @default(now()) @map("created_at")
  payments ManualPayment[]
  results PaymentResult[]
  @@unique([sourceType, sourceId])
  @@index([recipientId, createdAt])
  @@index([payerId, createdAt])
  @@map("payment_operations")
}
model PaymentResult {

  paymentId String @id @map("payment_id") @db.Uuid
  payment ManualPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  operationId String @map("operation_id") @db.Uuid
  operation PaymentOperation @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sourceType String @map("source_type") @db.VarChar(40)
  sourceId String @map("source_id") @db.VarChar(100)
  status String @db.VarChar(20)
  reviewedAt DateTime @map("reviewed_at")
  reviewedBy String @map("reviewed_by") @db.Uuid
  rejectionReason String? @map("rejection_reason") @db.VarChar(300)
  @@map("payment_results")
}
model Session {

  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @map("token_hash") @db.Char(64)
  userId String @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model ShopCategory {

  id String @id @db.Uuid
  name String @unique @db.VarChar(120)
  slug String @unique @db.VarChar(140)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  products ShopProduct[]
  @@map("shop_categories")
}
model ShopProduct {

  revision Int @default(0)
  id String @id @db.Uuid
  categoryId String? @map("category_id") @db.Uuid
  category ShopCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  name String @db.VarChar(180)
  description String
  imageFileId String? @map("image_file_id") @db.Uuid
  image StoredFile? @relation("ShopImage", fields: [imageFileId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  priceCents Int @map("price_cents")
  published Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  variants ShopVariant[]
  @@index([published, categoryId], map: "shop_products_catalog_idx")
  @@map("shop_products")
}
model ShopVariant {

  id String @id @db.Uuid
  productId String @map("product_id") @db.Uuid
  product ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  name String @db.VarChar(160)
  sku String @unique @db.VarChar(80)
  priceCents Int @map("price_cents")
  stock Int
  position Int @default(0)
  @@map("shop_variants")
}
model ShopCart {

  id String @id @db.Uuid
  userId String? @map("user_id") @db.Uuid
  user User? @relation("ShopCartUser", fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  items Json
  totalCents Int @map("total_cents")
  currency String @default("PEN") @db.Char(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@map("shop_carts")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  FINISHED
  CANCELLED
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

model Team {
  disciplines Discipline[] @relation("TeamSports")
  discoverable Boolean @default(false)
  joinPolicy String @default("INVITE") @map("join_policy") @db.VarChar(20)
  admissions TeamAdmission[]
  paymentMethods TeamPaymentMethod[]
  paymentRecipientId String? @unique @map("payment_recipient_id") @db.Uuid
  paymentRecipient PaymentRecipient? @relation(fields: [paymentRecipientId], references: [id], onDelete: Restrict)
  events Event[]
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(120)
  description String @default("") @db.VarChar(2000)
  logoFileId String? @map("logo_file_id") @db.Uuid
  logo StoredFile? @relation("TeamLogo", fields: [logoFileId], references: [id], onDelete: Restrict)
  bannerFileId String? @map("banner_file_id") @db.Uuid
  banner StoredFile? @relation("TeamBanner", fields: [bannerFileId], references: [id], onDelete: Restrict)
  contactName String? @map("contact_name") @db.VarChar(120)
  phone String? @db.VarChar(40)
  whatsapp String? @db.VarChar(40)
  email String? @db.VarChar(254)
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  members TeamMember[]
  @@map("teams")
}

model TeamMember {
  id String @id @default(uuid()) @db.Uuid
  teamId String @map("team_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  role TeamRole @default(MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([teamId, userId])
  @@index([userId, joinedAt])
  @@map("team_members")
}
model Event {
    meetingAt DateTime? @map("meeting_at") @db.Timestamptz(6)
    meetingVenue String? @map("meeting_venue") @db.VarChar(500)
    kitDateFrom DateTime? @map("kit_date_from") @db.Date
    kitDateTo DateTime? @map("kit_date_to") @db.Date
    kitTimeFrom String? @map("kit_time_from") @db.VarChar(5)
    kitTimeTo String? @map("kit_time_to") @db.VarChar(5)
    kitInstructions String? @map("kit_instructions") @db.VarChar(2000)
    kitEnabled Boolean @default(false) @map("kit_enabled")
    kitStartsAt DateTime? @map("kit_starts_at") @db.Timestamptz(6)
    kitEndsAt DateTime? @map("kit_ends_at") @db.Timestamptz(6)
    kitVenue String? @map("kit_venue") @db.VarChar(500)
    kitAddress String? @map("kit_address") @db.VarChar(500)
    competitionConfig Json? @map("competition_config")
    timeLimitMinutes Int? @map("time_limit_minutes")
    routeImages EventRouteImage[]
    routeImageFileId String? @map("route_image_file_id") @db.Uuid
    routeImage StoredFile? @relation("EventRoute", fields: [routeImageFileId], references: [id], onDelete: Restrict)

  personalPaymentMethods TeamPaymentMethod[] @relation("PersonalEventMethods")
  mode String @default("MANAGED") @db.VarChar(20)
  publicOrganizerName String? @map("public_organizer_name") @db.VarChar(160)
  publicOrganizerPhone String? @map("public_organizer_phone") @db.VarChar(40)
  publicOrganizerEmail String? @map("public_organizer_email") @db.VarChar(254)
  externalUrl String? @map("external_url") @db.VarChar(2048)
  disciplineId String? @map("discipline_id") @db.Uuid
  discipline Discipline? @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  categories EventCategory[]
  enabledPaymentMethods EventPaymentMethod[]
  teamId String? @map("team_id") @db.Uuid
  team Team? @relation(fields: [teamId], references: [id], onDelete: Restrict)
  createdByUserId String? @map("created_by_user_id") @db.Uuid
  createdBy User? @relation("EventCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  registrationEventRows EventRegistration[] @relation("RegistrationEvent")
  registrationConfigEventRows EventRegistrationConfig[] @relation("RegistrationConfigEvent")
  id String @id @db.Uuid
  organizerId String @map("organizer_id") @db.Uuid
  organizer User @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  publicSlug String @unique @map("public_slug")
  title String
  description String
  type String?
  startsAt DateTime? @map("starts_at") @db.Timestamptz(6)
  timeZone String @map("time_zone")
  venue String?
  virtualUrl String? @map("virtual_url")
  status EventStatus @default(DRAFT)
  source String @default("INVICTUS")
  reviewStatus String @default("DRAFT") @map("review_status")
  reviewNote String? @map("review_note")
  primaryImageFileId String? @map("primary_image_file_id") @db.Uuid
  primaryImage StoredFile? @relation("EventPrimary", fields: [primaryImageFileId], references: [id], onDelete: Restrict)
  bannerImageFileId String? @map("banner_image_file_id") @db.Uuid
  bannerImage StoredFile? @relation("EventBanner", fields: [bannerImageFileId], references: [id], onDelete: Restrict)
  galleryFileIds Json @default("[]") @map("gallery_file_ids")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  benefits EventBenefit[]
  @@index([organizerId, status], map: "events_organizer_status_idx")
  @@index([teamId, status], map: "events_team_status_idx")
  @@unique([id, teamId])
  @@map("events")
}

model Discipline {
  externalParticipations ExternalParticipation[]
  participantDisciplineRows ParticipantDiscipline[]
  teams Team[] @relation("TeamSports")
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(40)
  name String @db.VarChar(120)
  active Boolean @default(true)
  events Event[]
  @@map("disciplines")
}

model EventCategory {
  modalities Json @default("[]")
  registrations EventRegistration[]
  id String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  name String @db.VarChar(160)
  description String? @db.VarChar(2000)
  gender String? @db.VarChar(10)
  minAge Int? @map("min_age")
  maxAge Int? @map("max_age")
  modality String? @db.VarChar(100)
  priceCents Int @map("price_cents")
  currency String @default("PEN") @db.Char(3)
  capacity Int?
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@unique([eventId, name])
  @@unique([id, eventId])
  @@index([eventId, active])
  @@map("event_categories")
}

enum TeamPaymentType {
  YAPE
  PLIN
  BANK_TRANSFER
  CASH
}

model TeamPaymentMethod {
  eventId String? @map("event_id") @db.Uuid
  personalEvent Event? @relation("PersonalEventMethods", fields: [eventId], references: [id], onDelete: Restrict)
  registrations EventRegistration[]
  id String @id @default(uuid()) @db.Uuid
  teamId String? @map("team_id") @db.Uuid
  team Team? @relation(fields: [teamId], references: [id], onDelete: Restrict)
  type TeamPaymentType
  label String @db.VarChar(120)
  phone String? @db.VarChar(40)
  holderName String? @map("holder_name") @db.VarChar(120)
  bank String? @db.VarChar(120)
  accountNumber String? @map("account_number") @db.VarChar(40)
  cci String? @db.VarChar(20)
  currency String @default("PEN") @db.Char(3)
  instructions String? @db.VarChar(2000)
  qrFileId String? @map("qr_file_id") @db.Uuid
  qr StoredFile? @relation(fields: [qrFileId], references: [id], onDelete: Restrict)
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  events EventPaymentMethod[]
  @@unique([id, teamId])
  @@index([teamId, active])
  @@index([eventId, active])
  @@map("team_payment_methods")
}

model EventPaymentMethod {
  eventId String @map("event_id") @db.Uuid
  methodId String @map("method_id") @db.Uuid
  teamId String? @map("team_id") @db.Uuid
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  method TeamPaymentMethod @relation(fields: [methodId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@id([eventId, methodId])
  @@map("event_payment_methods")
}
model EventBenefit {

  id String @id @db.Uuid
  eventId String @map("event_id") @db.Uuid
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  kind String
  name String
  description String?
  imageFileId String? @map("image_file_id") @db.Uuid
  image StoredFile? @relation("BenefitImage", fields: [imageFileId], references: [id], onDelete: Restrict)
  condition String?
  position Int @default(0)
  @@map("event_benefits")
}

enum ProfileGender {
  MALE
  FEMALE
  NON_BINARY
  SELF_DESCRIBED
  PREFER_NOT_TO_SAY
}
enum IdentityDocumentType {
  DNI
  FOREIGN_RESIDENT_CARD
  PASSPORT
}
enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  FACEBOOK
  YOUTUBE
  LINKEDIN
}
model ParticipantSocialLink {
  id String @id @default(uuid()) @db.Uuid
  participantProfileId String @map("participant_profile_id") @db.Uuid
  profile ParticipantProfile @relation(fields: [participantProfileId], references: [id], onDelete: Cascade, map: "participant_social_links_profile_fkey")
  platform SocialPlatform
  url String @db.VarChar(2048)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@unique([participantProfileId, platform])
  @@map("participant_social_links")
}
model ParticipantDiscipline {
  participantProfileId String @map("participant_profile_id") @db.Uuid
  disciplineId String @map("discipline_id") @db.Uuid
  isPrimary Boolean @default(false) @map("is_primary")
  profile ParticipantProfile @relation(fields: [participantProfileId], references: [id], onDelete: Cascade)
  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  @@id([participantProfileId, disciplineId])
  @@index([disciplineId])
  @@map("participant_disciplines")
}
model ExternalParticipation {
  id String @id @default(uuid()) @db.Uuid
  participantProfileId String @map("participant_profile_id") @db.Uuid
  profile ParticipantProfile @relation(fields: [participantProfileId], references: [id], onDelete: Cascade)
  disciplineId String @map("discipline_id") @db.Uuid
  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  eventName String @map("event_name") @db.VarChar(160)
  year Int
  eventDate DateTime? @map("event_date") @db.Date
  location String? @db.VarChar(160)
  eventTest String? @map("event_test") @db.VarChar(120)
  category String? @db.VarChar(120)
  result String? @db.VarChar(120)
  position Int?
  organizer String? @db.VarChar(160)
  description String? @db.VarChar(2000)
  officialUrl String? @map("official_url") @db.VarChar(2048)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@index([participantProfileId, year])
  @@index([disciplineId])
  @@map("external_participations")
}
model ParticipantProfile {
  externalParticipations ExternalParticipation[]
  participantDisciplines ParticipantDiscipline[]
  websiteUrl String? @map("website_url") @db.VarChar(2048)
  socialLinks ParticipantSocialLink[]
  name String? @db.VarChar(80)
  lastName String? @map("last_name") @db.VarChar(120)
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  gender ProfileGender?
  documentType IdentityDocumentType? @map("document_type")
  documentNumber String? @map("document_number") @db.VarChar(30)
  phone String? @db.VarChar(16)
  countryCode String? @map("country_code") @db.Char(2)
  department String? @db.VarChar(120)
  province String? @db.VarChar(120)
  district String? @db.VarChar(120)
  ubigeoCode String? @map("ubigeo_code") @db.Char(6)
  bannerFileId String? @map("banner_file_id") @db.Uuid
  banner StoredFile? @relation("ProfileBanner", fields: [bannerFileId], references: [id], onDelete: Restrict)
  registrationProfileRows EventRegistration[] @relation("RegistrationProfile")
  id String @id @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  user User @relation("ProfileUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  publicName String @map("public_name")
  bio String @default("")
  location String?
  // Read-only legacy archive; current sports live in participantDisciplines.
  disciplines Json @default("[]")
  experience String @default("")
  achievements String @default("")
  avatarFileId String? @map("avatar_file_id") @db.Uuid
  avatar StoredFile? @relation("ProfileAvatar", fields: [avatarFileId], references: [id], onDelete: Restrict)
  documentFileIds Json @default("[]") @map("document_file_ids")
  publicLink String? @map("public_link")
  visibility String @default("PRIVATE")
  moderationStatus String @default("PENDING") @map("moderation_status")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@map("participant_profiles")
}

model EventRegistration {
  guestAccessHash String? @unique @map("guest_access_hash") @db.Char(64)
  categoryId String? @map("category_id") @db.Uuid
  category EventCategory? @relation(fields: [categoryId, eventId], references: [id, eventId], onDelete: Restrict, onUpdate: NoAction)
  methodId String? @map("method_id") @db.Uuid
  method TeamPaymentMethod? @relation(fields: [methodId], references: [id], onDelete: Restrict)
  categorySnapshot Json? @map("category_snapshot")
  participantSnapshot Json? @map("participant_snapshot")
  amountCents Int? @map("amount_cents")
  currency String? @db.Char(3)
  reviewNote String? @map("review_note") @db.VarChar(300)
  version Int @default(1)
  audits RegistrationAudit[]
  profile ParticipantProfile? @relation("RegistrationProfile", fields: [profileId], references: [id], onDelete: Restrict)
  id String @id @db.Uuid
  eventId String @map("event_id") @db.Uuid
  event Event @relation("RegistrationEvent", fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId String? @map("user_id") @db.Uuid
  user User? @relation("RegistrationUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status String
  paymentInstructionsSnapshot Json? @map("payment_instructions_snapshot")
  proofFileId String? @map("proof_file_id") @db.Uuid
  proof StoredFile? @relation("RegistrationProof", fields: [proofFileId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  participationCode String? @unique @map("participation_code")
  participationQrDataUrl String? @map("participation_qr_data_url")
  profileId String? @map("profile_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@unique([eventId, userId])
  @@index([eventId, status], map: "event_registrations_event_status_idx")
  @@index([categoryId, status])
  @@map("event_registrations")
}

