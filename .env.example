DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/invictus?schema=public
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/invictus_test?schema=public
NODE_ENV=development
PORT=3100
WEB_ORIGINS=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173
STORAGE_DRIVER=local
UPLOAD_DIRECTORY=./uploads
FILE_SIGNING_KEY=replace-with-at-least-32-random-characters
# Production requires S3 and HTTPS. Never prefix backend secrets with VITE_.
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set after provisioning recipient using the administrative setup script.
PAYMENT_RECIPIENT_ID=00000000-0000-4000-8000-000000000001
PAYMENT_METHODS=cash
TRUST_PROXY=0
# Public frontend variable, baked into build. Use /api with same-origin reverse proxy.
VITE_API_URL=/api

VITE_ADMIN_URL=http://localhost:5175
VITE_PUBLIC_URL=http://localhost:5173
